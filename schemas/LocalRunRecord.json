{
  "$defs": {
    "ActionReceipt": {
      "additionalProperties": false,
      "properties": {
        "receipt_id": {
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:-]{0,127}$",
          "title": "Receipt Id",
          "type": "string"
        },
        "idempotency_key": {
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:-]{0,127}$",
          "title": "Idempotency Key",
          "type": "string"
        },
        "proposal_id": {
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:-]{0,127}$",
          "title": "Proposal Id",
          "type": "string"
        },
        "proposal_hash": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Proposal Hash",
          "type": "string"
        },
        "before": {
          "$ref": "#/$defs/ServiceState"
        },
        "after": {
          "$ref": "#/$defs/ServiceState"
        },
        "status": {
          "enum": [
            "applied",
            "not_applied"
          ],
          "title": "Status",
          "type": "string"
        },
        "audited_at": {
          "format": "date-time",
          "title": "Audited At",
          "type": "string"
        }
      },
      "required": [
        "receipt_id",
        "idempotency_key",
        "proposal_id",
        "proposal_hash",
        "before",
        "after",
        "status",
        "audited_at"
      ],
      "title": "ActionReceipt",
      "type": "object"
    },
    "Approval": {
      "additionalProperties": false,
      "properties": {
        "approval_id": {
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:-]{0,127}$",
          "title": "Approval Id",
          "type": "string"
        },
        "proposal_id": {
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:-]{0,127}$",
          "title": "Proposal Id",
          "type": "string"
        },
        "proposal_hash": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Proposal Hash",
          "type": "string"
        },
        "approver_id": {
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:-]{0,127}$",
          "title": "Approver Id",
          "type": "string"
        },
        "authorized_service": {
          "const": "checkout-api",
          "title": "Authorized Service",
          "type": "string"
        },
        "decision": {
          "enum": [
            "approved",
            "rejected"
          ],
          "title": "Decision",
          "type": "string"
        },
        "reason": {
          "maxLength": 4000,
          "minLength": 1,
          "title": "Reason",
          "type": "string"
        },
        "decided_at": {
          "format": "date-time",
          "title": "Decided At",
          "type": "string"
        },
        "expires_at": {
          "format": "date-time",
          "title": "Expires At",
          "type": "string"
        }
      },
      "required": [
        "approval_id",
        "proposal_id",
        "proposal_hash",
        "approver_id",
        "authorized_service",
        "decision",
        "reason",
        "decided_at",
        "expires_at"
      ],
      "title": "Approval",
      "type": "object"
    },
    "AuditEvent": {
      "additionalProperties": false,
      "properties": {
        "at": {
          "format": "date-time",
          "title": "At",
          "type": "string"
        },
        "actor": {
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:-]{0,127}$",
          "title": "Actor",
          "type": "string"
        },
        "event": {
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:-]{0,127}$",
          "title": "Event",
          "type": "string"
        },
        "detail": {
          "maxLength": 4000,
          "minLength": 1,
          "title": "Detail",
          "type": "string"
        }
      },
      "required": [
        "at",
        "actor",
        "event",
        "detail"
      ],
      "title": "AuditEvent",
      "type": "object"
    },
    "Change": {
      "additionalProperties": false,
      "properties": {
        "change_id": {
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:-]{0,127}$",
          "title": "Change Id",
          "type": "string"
        },
        "changed_at": {
          "format": "date-time",
          "title": "Changed At",
          "type": "string"
        },
        "kind": {
          "enum": [
            "deployment",
            "configuration"
          ],
          "title": "Kind",
          "type": "string"
        },
        "release": {
          "enum": [
            "release-41",
            "release-42"
          ],
          "title": "Release",
          "type": "string"
        },
        "summary": {
          "maxLength": 4000,
          "minLength": 1,
          "title": "Summary",
          "type": "string"
        }
      },
      "required": [
        "change_id",
        "changed_at",
        "kind",
        "release",
        "summary"
      ],
      "title": "Change",
      "type": "object"
    },
    "Changes": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "changes",
          "title": "Kind",
          "type": "string"
        },
        "service_id": {
          "const": "checkout-api",
          "title": "Service Id",
          "type": "string"
        },
        "items": {
          "items": {
            "$ref": "#/$defs/Change"
          },
          "maxItems": 20,
          "title": "Items",
          "type": "array"
        }
      },
      "required": [
        "kind",
        "service_id",
        "items"
      ],
      "title": "Changes",
      "type": "object"
    },
    "Evidence": {
      "additionalProperties": false,
      "properties": {
        "evidence_id": {
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:-]{0,127}$",
          "title": "Evidence Id",
          "type": "string"
        },
        "source": {
          "enum": [
            "get_service_health",
            "get_recent_changes",
            "get_recent_logs",
            "retrieve_runbook"
          ],
          "title": "Source",
          "type": "string"
        },
        "collected_at": {
          "format": "date-time",
          "title": "Collected At",
          "type": "string"
        },
        "source_version": {
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:-]{0,127}$",
          "title": "Source Version",
          "type": "string"
        },
        "content_hash": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Content Hash",
          "type": "string"
        },
        "complete": {
          "title": "Complete",
          "type": "boolean"
        },
        "sanitized": {
          "const": true,
          "title": "Sanitized",
          "type": "boolean"
        },
        "payload": {
          "discriminator": {
            "mapping": {
              "changes": "#/$defs/Changes",
              "health": "#/$defs/Health",
              "logs": "#/$defs/Logs",
              "runbook": "#/$defs/Passage"
            },
            "propertyName": "kind"
          },
          "oneOf": [
            {
              "$ref": "#/$defs/Health"
            },
            {
              "$ref": "#/$defs/Changes"
            },
            {
              "$ref": "#/$defs/Logs"
            },
            {
              "$ref": "#/$defs/Passage"
            }
          ],
          "title": "Payload"
        }
      },
      "required": [
        "evidence_id",
        "source",
        "collected_at",
        "source_version",
        "content_hash",
        "complete",
        "sanitized",
        "payload"
      ],
      "title": "Evidence",
      "type": "object"
    },
    "Finding": {
      "additionalProperties": false,
      "properties": {
        "statement": {
          "maxLength": 4000,
          "minLength": 1,
          "title": "Statement",
          "type": "string"
        },
        "evidence_ids": {
          "items": {
            "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:-]{0,127}$",
            "type": "string"
          },
          "maxItems": 16,
          "minItems": 1,
          "title": "Evidence Ids",
          "type": "array"
        }
      },
      "required": [
        "statement",
        "evidence_ids"
      ],
      "title": "Finding",
      "type": "object"
    },
    "Health": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "health",
          "title": "Kind",
          "type": "string"
        },
        "service_id": {
          "const": "checkout-api",
          "title": "Service Id",
          "type": "string"
        },
        "observed_at": {
          "format": "date-time",
          "title": "Observed At",
          "type": "string"
        },
        "release": {
          "enum": [
            "release-41",
            "release-42"
          ],
          "title": "Release",
          "type": "string"
        },
        "error_rate": {
          "maximum": 1,
          "minimum": 0,
          "title": "Error Rate",
          "type": "number"
        },
        "latency_p95_ms": {
          "maximum": 120000,
          "minimum": 0,
          "title": "Latency P95 Ms",
          "type": "number"
        },
        "dependency_state": {
          "enum": [
            "healthy",
            "degraded",
            "unknown"
          ],
          "title": "Dependency State",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "service_id",
        "observed_at",
        "release",
        "error_rate",
        "latency_p95_ms",
        "dependency_state"
      ],
      "title": "Health",
      "type": "object"
    },
    "Hypothesis": {
      "additionalProperties": false,
      "properties": {
        "cause": {
          "maxLength": 4000,
          "minLength": 1,
          "title": "Cause",
          "type": "string"
        },
        "supporting_evidence": {
          "default": [],
          "items": {
            "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:-]{0,127}$",
            "type": "string"
          },
          "title": "Supporting Evidence",
          "type": "array"
        },
        "contradicting_evidence": {
          "default": [],
          "items": {
            "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:-]{0,127}$",
            "type": "string"
          },
          "title": "Contradicting Evidence",
          "type": "array"
        },
        "status": {
          "enum": [
            "candidate",
            "supported",
            "pruned"
          ],
          "title": "Status",
          "type": "string"
        }
      },
      "required": [
        "cause",
        "status"
      ],
      "title": "Hypothesis",
      "type": "object"
    },
    "Investigation": {
      "additionalProperties": false,
      "properties": {
        "run_id": {
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:-]{0,127}$",
          "title": "Run Id",
          "type": "string"
        },
        "outcome": {
          "enum": [
            "propose_rollback",
            "escalate",
            "incomplete"
          ],
          "title": "Outcome",
          "type": "string"
        },
        "facts": {
          "items": {
            "$ref": "#/$defs/Finding"
          },
          "maxItems": 20,
          "title": "Facts",
          "type": "array"
        },
        "hypotheses": {
          "items": {
            "$ref": "#/$defs/Hypothesis"
          },
          "maxItems": 2,
          "title": "Hypotheses",
          "type": "array"
        },
        "missing_information": {
          "items": {
            "maxLength": 4000,
            "minLength": 1,
            "type": "string"
          },
          "title": "Missing Information",
          "type": "array"
        },
        "next_check": {
          "anyOf": [
            {
              "maxLength": 4000,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Next Check"
        },
        "justification": {
          "maxLength": 4000,
          "minLength": 1,
          "title": "Justification",
          "type": "string"
        }
      },
      "required": [
        "run_id",
        "outcome",
        "facts",
        "hypotheses",
        "missing_information",
        "next_check",
        "justification"
      ],
      "title": "Investigation",
      "type": "object"
    },
    "LogEntry": {
      "additionalProperties": false,
      "properties": {
        "observed_at": {
          "format": "date-time",
          "title": "Observed At",
          "type": "string"
        },
        "message": {
          "maxLength": 2000,
          "minLength": 1,
          "title": "Message",
          "type": "string"
        }
      },
      "required": [
        "observed_at",
        "message"
      ],
      "title": "LogEntry",
      "type": "object"
    },
    "Logs": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "logs",
          "title": "Kind",
          "type": "string"
        },
        "service_id": {
          "const": "checkout-api",
          "title": "Service Id",
          "type": "string"
        },
        "entries": {
          "items": {
            "$ref": "#/$defs/LogEntry"
          },
          "maxItems": 50,
          "title": "Entries",
          "type": "array"
        },
        "truncated": {
          "title": "Truncated",
          "type": "boolean"
        }
      },
      "required": [
        "kind",
        "service_id",
        "entries",
        "truncated"
      ],
      "title": "Logs",
      "type": "object"
    },
    "Passage": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "runbook",
          "title": "Kind",
          "type": "string"
        },
        "service_id": {
          "const": "checkout-api",
          "title": "Service Id",
          "type": "string"
        },
        "passage_id": {
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:-]{0,127}$",
          "title": "Passage Id",
          "type": "string"
        },
        "document_id": {
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:-]{0,127}$",
          "title": "Document Id",
          "type": "string"
        },
        "version": {
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:-]{0,127}$",
          "title": "Version",
          "type": "string"
        },
        "owner": {
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:-]{0,127}$",
          "title": "Owner",
          "type": "string"
        },
        "valid_from": {
          "format": "date-time",
          "title": "Valid From",
          "type": "string"
        },
        "valid_until": {
          "format": "date-time",
          "title": "Valid Until",
          "type": "string"
        },
        "status": {
          "enum": [
            "current",
            "stale",
            "conflicting"
          ],
          "title": "Status",
          "type": "string"
        },
        "excerpt": {
          "maxLength": 4000,
          "minLength": 1,
          "title": "Excerpt",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "service_id",
        "passage_id",
        "document_id",
        "version",
        "owner",
        "valid_from",
        "valid_until",
        "status",
        "excerpt"
      ],
      "title": "Passage",
      "type": "object"
    },
    "Proposal": {
      "additionalProperties": false,
      "properties": {
        "proposal_id": {
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:-]{0,127}$",
          "title": "Proposal Id",
          "type": "string"
        },
        "run_id": {
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:-]{0,127}$",
          "title": "Run Id",
          "type": "string"
        },
        "action": {
          "const": "rollback_demo_release",
          "title": "Action",
          "type": "string"
        },
        "arguments": {
          "$ref": "#/$defs/RollbackArguments"
        },
        "expected_current_release": {
          "const": "release-42",
          "title": "Expected Current Release",
          "type": "string"
        },
        "evidence_ids": {
          "items": {
            "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:-]{0,127}$",
            "type": "string"
          },
          "maxItems": 16,
          "minItems": 1,
          "title": "Evidence Ids",
          "type": "array"
        },
        "created_at": {
          "format": "date-time",
          "title": "Created At",
          "type": "string"
        },
        "expires_at": {
          "format": "date-time",
          "title": "Expires At",
          "type": "string"
        },
        "proposal_hash": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Proposal Hash",
          "type": "string"
        }
      },
      "required": [
        "proposal_id",
        "run_id",
        "action",
        "arguments",
        "expected_current_release",
        "evidence_ids",
        "created_at",
        "expires_at",
        "proposal_hash"
      ],
      "title": "Proposal",
      "type": "object"
    },
    "Request": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "1.0.0",
          "default": "1.0.0",
          "title": "Schema Version",
          "type": "string"
        },
        "request_id": {
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:-]{0,127}$",
          "title": "Request Id",
          "type": "string"
        },
        "principal_id": {
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:-]{0,127}$",
          "title": "Principal Id",
          "type": "string"
        },
        "service_id": {
          "const": "checkout-api",
          "title": "Service Id",
          "type": "string"
        },
        "idempotency_key": {
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:-]{0,127}$",
          "title": "Idempotency Key",
          "type": "string"
        },
        "submitted_at": {
          "format": "date-time",
          "title": "Submitted At",
          "type": "string"
        },
        "summary": {
          "maxLength": 4000,
          "minLength": 1,
          "title": "Summary",
          "type": "string"
        }
      },
      "required": [
        "request_id",
        "principal_id",
        "service_id",
        "idempotency_key",
        "submitted_at",
        "summary"
      ],
      "title": "Request",
      "type": "object"
    },
    "RollbackArguments": {
      "additionalProperties": false,
      "properties": {
        "service_id": {
          "const": "checkout-api",
          "title": "Service Id",
          "type": "string"
        },
        "target_release": {
          "const": "release-41",
          "title": "Target Release",
          "type": "string"
        }
      },
      "required": [
        "service_id",
        "target_release"
      ],
      "title": "RollbackArguments",
      "type": "object"
    },
    "Run": {
      "additionalProperties": false,
      "properties": {
        "run_id": {
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:-]{0,127}$",
          "title": "Run Id",
          "type": "string"
        },
        "request_id": {
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:-]{0,127}$",
          "title": "Request Id",
          "type": "string"
        },
        "mode": {
          "enum": [
            "local_stub",
            "aws_live"
          ],
          "title": "Mode",
          "type": "string"
        },
        "state": {
          "enum": [
            "pending",
            "investigating",
            "incomplete",
            "awaiting_approval",
            "rejected",
            "expired",
            "executing",
            "verifying",
            "resolved",
            "unresolved",
            "failed",
            "escalated"
          ],
          "title": "State",
          "type": "string"
        },
        "versions": {
          "$ref": "#/$defs/Versions"
        },
        "started_at": {
          "format": "date-time",
          "title": "Started At",
          "type": "string"
        },
        "finished_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Finished At"
        },
        "active_latency_ms": {
          "default": 0,
          "minimum": 0,
          "title": "Active Latency Ms",
          "type": "integer"
        },
        "usage": {
          "$ref": "#/$defs/Usage",
          "default": {
            "model_calls": 0,
            "tool_calls": 0,
            "input_tokens": 0,
            "output_tokens": 0
          }
        },
        "trace_ids": {
          "default": [],
          "items": {
            "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:-]{0,127}$",
            "type": "string"
          },
          "title": "Trace Ids",
          "type": "array"
        }
      },
      "required": [
        "run_id",
        "request_id",
        "mode",
        "state",
        "versions",
        "started_at"
      ],
      "title": "Run",
      "type": "object"
    },
    "ServiceState": {
      "additionalProperties": false,
      "properties": {
        "service_id": {
          "const": "checkout-api",
          "title": "Service Id",
          "type": "string"
        },
        "release": {
          "enum": [
            "release-41",
            "release-42"
          ],
          "title": "Release",
          "type": "string"
        },
        "revision": {
          "minimum": 0,
          "title": "Revision",
          "type": "integer"
        }
      },
      "required": [
        "service_id",
        "release",
        "revision"
      ],
      "title": "ServiceState",
      "type": "object"
    },
    "ToolAttempt": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "enum": [
            "get_service_health",
            "get_recent_changes",
            "get_recent_logs",
            "retrieve_runbook"
          ],
          "title": "Name",
          "type": "string"
        },
        "attempt": {
          "maximum": 2,
          "minimum": 1,
          "title": "Attempt",
          "type": "integer"
        },
        "status": {
          "enum": [
            "ok",
            "error"
          ],
          "title": "Status",
          "type": "string"
        },
        "error_code": {
          "anyOf": [
            {
              "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:-]{0,127}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Error Code"
        },
        "evidence_ids": {
          "default": [],
