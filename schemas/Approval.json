{
  "additionalProperties": false,
  "properties": {
    "approval_id": {
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:-]{0,127}$",
      "title": "Approval Id",
      "type": "string"
    },
    "proposal_id": {
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:-]{0,127}$",
      "title": "Proposal Id",
      "type": "string"
    },
    "proposal_hash": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Proposal Hash",
      "type": "string"
    },
    "approver_id": {
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:-]{0,127}$",
      "title": "Approver Id",
      "type": "string"
    },
    "authorized_service": {
      "const": "checkout-api",
      "title": "Authorized Service",
      "type": "string"
    },
    "decision": {
      "enum": [
        "approved",
        "rejected"
      ],
      "title": "Decision",
      "type": "string"
    },
    "reason": {
      "maxLength": 4000,
      "minLength": 1,
      "title": "Reason",
      "type": "string"
    },
    "decided_at": {
      "format": "date-time",
      "title": "Decided At",
      "type": "string"
    },
    "expires_at": {
      "format": "date-time",
      "title": "Expires At",
      "type": "string"
    }
  },
  "required": [
    "approval_id",
    "proposal_id",
    "proposal_hash",
    "approver_id",
    "authorized_service",
    "decision",
    "reason",
    "decided_at",
    "expires_at"
  ],
  "title": "Approval",
  "type": "object"
}
